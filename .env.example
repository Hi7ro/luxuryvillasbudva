# Private iCal export URLs. Separate multiple feeds with commas.
# Never commit real calendar URLs.
# Airbnb listing 1705759468224071749 = Villa MonteMare
# Airbnb listing 1537533887511380169 = Villa Lumina
PUBLIC_SITE_ORIGIN=https://www.example.com
ICAL_MONTE_MARE_URLS=https://example.com/monte-mare-airbnb.ics,https://example.com/monte-mare-booking.ics
ICAL_LUMINA_URLS=https://example.com/lumina-airbnb.ics,https://example.com/lumina-booking.ics
