{
  "name": "villa-montemare-lumina",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/finalize-dist.mjs",
    "build:prerender": "ng build --configuration production && node scripts/finalize-dist.mjs",
    "serve:ssr": "node dist/villa-montemare-lumina/server/server.mjs",
    "serve:ssr:env": "node --env-file=.env dist/villa-montemare-lumina/server/server.mjs",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test": "npm run typecheck",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/ssr": "^18.2.0",
    "express": "^4.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "~5.5.0"
  }
}
