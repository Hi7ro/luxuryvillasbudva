Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Keep the public API URL identical to the Angular/Express implementation.
RewriteRule ^api/availability/?$ api/availability.php [L,QSA]

# Existing files and directories are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Angular client-side routes such as /de and /de/villen/villa-lumina.
RewriteRule ^ index.html [L]

