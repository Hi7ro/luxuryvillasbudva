Options -Indexes
DirectoryIndex index.html index.csr.html

RewriteEngine On

# Keep the public API URL identical to the Angular/Express implementation.
RewriteRule ^api/availability/?$ api/availability.php [L,QSA]

# Existing files and directories are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Angular client-side routes such as /de and /sr/villas/villa-lumina.
# Angular's SSR-capable browser build names the static entry file index.csr.html.
RewriteRule ^ index.csr.html [L]
